@model sealHkthon.Entities.ThuanVCT.Models.EventsThuanVct

@{
    ViewData["Title"] = "Edit Event";
}

<style>
    .edit-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2rem 2.5rem;
        max-width: 620px;
        margin: 2rem auto;
    }
    .edit-card .card-header-section {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
    }
    .edit-card .card-icon {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, #3b6ef8, #60a5fa);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.4rem;
        flex-shrink: 0;
    }
    .edit-card h2 {
        font-size: 1.4rem; font-weight: 700;
        color: #1a1a2e; margin: 0;
    }
    .edit-card .subtitle {
        font-size: 0.82rem; color: #888; margin: 0;
    }
    .form-field {
        margin-bottom: 1.2rem;
    }
    .form-field label {
        display: block;
        font-size: 0.78rem; font-weight: 700;
        color: #888; text-transform: uppercase;
        letter-spacing: 0.05em; margin-bottom: 6px;
    }
    .form-field input[type="text"],
    .form-field input[type="number"],
    .form-field input[type="datetime-local"],
    .form-field input:not([type="checkbox"]):not([type="submit"]):not([type="button"]) {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        font-size: 0.95rem;
        color: #1a1a2e;
        background: #fafafa;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }
    .form-field input:focus {
        border-color: #3b6ef8;
        box-shadow: 0 0 0 3px rgba(59, 110, 248, 0.12);
        background: #fff;
    }
    .form-check-modern {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        background: #fafafa;
        cursor: pointer;
        margin-bottom: 1.2rem;
        transition: border-color 0.2s;
    }
    .form-check-modern:hover { border-color: #3b6ef8; }
    .form-check-modern input[type="checkbox"] {
        width: 18px; height: 18px; cursor: pointer;
        accent-color: #3b6ef8;
    }
    .form-check-modern span {
        font-size: 0.9rem; font-weight: 600; color: #444;
    }
    .action-bar {
        display: flex; gap: 0.75rem; flex-wrap: wrap;
        margin-top: 1.5rem; padding-top: 1rem;
        border-top: 2px solid #f0f0f0;
        align-items: center;
    }
    .btn-save {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 22px; border-radius: 10px;
        background: linear-gradient(135deg, #3b6ef8, #60a5fa);
        color: white; font-weight: 700; font-size: 0.9rem;
        border: none; cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
        text-decoration: none;
    }
    .btn-save:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-signalr {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 22px; border-radius: 10px;
        background: linear-gradient(135deg, #0ea5e9, #38bdf8); /* Cyan/Blue to differentiate from save */
        color: white; font-weight: 700; font-size: 0.9rem;
        border: none; cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
    }
    .btn-signalr:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-back {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 18px; border-radius: 10px;
        background: #f0f0f0; color: #555;
        font-weight: 600; font-size: 0.88rem;
        border: none; cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
        margin-left: auto;
    }
    .btn-back:hover { background: #e0e0e0; color: #333; }
    .text-danger-field { font-size: 0.8rem; color: #e74c3c; margin-top: 3px; }
</style>

<div class="edit-card">
    <div class="card-header-section">
        <div class="card-icon"><i class="bi bi-pencil-square"></i></div>
        <div>
            <h2>Edit Event</h2>
            <p class="subtitle">EventsThuanVct &nbsp;·&nbsp; ID: @Model.EventThuanVctid</p>
        </div>
    </div>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="EventThuanVctid" />

        <div class="form-field">
            <label asp-for="EventName"><i class="bi bi-tag me-1"></i>Event Name</label>
            <input asp-for="EventName" placeholder="Enter event name..." />
            <div class="text-danger-field"><span asp-validation-for="EventName"></span></div>
        </div>

        <div class="form-field">
            <label asp-for="Description"><i class="bi bi-text-paragraph me-1"></i>Description</label>
            <input asp-for="Description" placeholder="Enter description..." />
            <div class="text-danger-field"><span asp-validation-for="Description"></span></div>
        </div>

        <div class="form-field">
            <label asp-for="Status"><i class="bi bi-circle-half me-1"></i>Status</label>
            <input asp-for="Status" type="number" placeholder="1 = Published, 0 = Draft" />
            <div class="text-danger-field"><span asp-validation-for="Status"></span></div>
        </div>

        <div class="form-field">
            <label asp-for="PublishDate"><i class="bi bi-calendar3 me-1"></i>Publish Date</label>
            <input asp-for="PublishDate" />
            <div class="text-danger-field"><span asp-validation-for="PublishDate"></span></div>
        </div>

        <label class="form-check-modern">
            <input class="form-check-input" asp-for="IsActive" />
            <span><i class="bi bi-toggle-on me-1"></i>@Html.DisplayNameFor(model => model.IsActive)</span>
        </label>

        <div class="action-bar">
            <button type="submit" class="btn-save">
                <i class="bi bi-floppy2"></i> Save
            </button>
            <button type="button" id="btnHubUpdate" class="btn-signalr">
                <i class="bi bi-broadcast"></i> Update via SignalR
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script>
        //VuLNS | Create connection to connect SignalR hub and invoke create method on button click
        var connection = new signalR.HubConnectionBuilder().withUrl("/eventHub").build();
        connection.start().then(function () {
            console.log("SignalR Connected.");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        document.getElementById("btnHubUpdate").addEventListener("click", function (event) {
                 var eventData = {
                                        EventThuanVctid: parseInt(document.getElementById("EventThuanVctid").value),
                              EventName: document.getElementById("EventName").value,
                              Description: document.getElementById("Description").value,
                                   Status: parseInt(document.getElementById("Status").value) || 0,
                              PublishDate:document.getElementById("PublishDate").value,
                     };

            connection.invoke("HubUpdateEvent", JSON.stringify(eventData))
                .then(function() {
                    window.location.href = '/EventsThuanVcts/Index';
                })
                .catch(function (err) {
                    return console.error(err.toString());
                });
                event.preventDefault();
        });

    </script>
}
