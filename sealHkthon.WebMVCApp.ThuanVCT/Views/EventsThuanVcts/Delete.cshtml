@model sealHkthon.Entities.ThuanVCT.Models.EventsThuanVct

@{
    ViewData["Title"] = "Delete Event";
}

<style>
    /* ── Shared design tokens (blue theme) ── */
    :root {
        --primary:        #3b6ef8;
        --primary-light:  #eef2ff;
        --primary-dark:   #2752d4;
        --danger:         #e74c3c;
        --danger-light:   #fdecea;
    }
    .event-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2rem 2.5rem;
        max-width: 660px;
        margin: 2rem auto;
    }
    .card-header-section {
        display: flex; align-items: center; gap: 1rem;
        margin-bottom: 1.5rem; padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
    }
    .card-icon {
        width: 52px; height: 52px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.4rem; flex-shrink: 0;
    }
    .icon-danger  { background: linear-gradient(135deg, var(--danger), #ff6b6b); }
    .card-title   { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; margin: 0; }
    .card-subtitle{ font-size: 0.82rem; color: #888; margin: 0; }

    /* Warning banner */
    .warn-banner {
        background: var(--danger-light);
        border-left: 4px solid var(--danger);
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 1.4rem;
        display: flex; align-items: center; gap: 10px;
        font-size: 0.9rem; font-weight: 600; color: var(--danger);
    }

    /* Field rows */
    .field-row {
        display: flex; align-items: flex-start;
        padding: 0.7rem 0; border-bottom: 1px solid #f5f5f5; gap: 1rem;
    }
    .field-row:last-child { border-bottom: none; }
    .field-label {
        width: 130px; flex-shrink: 0;
        font-size: 0.78rem; font-weight: 700; color: #888;
        text-transform: uppercase; letter-spacing: 0.05em; padding-top: 2px;
    }
    .field-value {
        flex: 1; font-size: 0.95rem; color: #1a1a2e; font-weight: 500;
    }
    .badge-status { display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
    .badge-published { background: #d4edda; color: #155724; }
    .badge-draft     { background: #f0f0f0; color: #666; }
    .badge-active    { background: #d1ecf1; color: #0c5460; }
    .badge-inactive  { background: #f8d7da; color: #721c24; }

    /* Action bar */
    .action-bar {
        display: flex; gap: 0.75rem; flex-wrap: wrap;
        margin-top: 1.5rem; padding-top: 1rem;
        border-top: 2px solid #f0f0f0; align-items: center;
    }
    .btn-danger-custom {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 22px; border-radius: 10px;
        background: linear-gradient(135deg, var(--danger), #ff6b6b);
        color: white; font-weight: 700; font-size: 0.9rem;
        border: none; cursor: pointer;
        transition: opacity 0.2s, transform 0.1s; text-decoration: none;
    }
    .btn-danger-custom:hover { opacity: 0.88; transform: translateY(-1px); color: white; }
    .btn-signalr {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 22px; border-radius: 10px;
        background: linear-gradient(135deg, #0ea5e9, #38bdf8);
        color: white; font-weight: 700; font-size: 0.9rem;
        border: none; cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
    }
    .btn-signalr:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-back {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 18px; border-radius: 10px;
        background: #f0f0f0; color: #555;
        font-weight: 600; font-size: 0.88rem; border: none;
        text-decoration: none; transition: background 0.2s; margin-left: auto;
    }
    .btn-back:hover { background: #e0e0e0; color: #333; }
</style>

<div class="event-card">
    <div class="card-header-section">
        <div class="card-icon icon-danger"><i class="bi bi-trash3"></i></div>
        <div>
            <h2 class="card-title">Delete Event</h2>
            <p class="card-subtitle">EventsThuanVct &nbsp;·&nbsp; ID: @Model.EventThuanVctid</p>
        </div>
    </div>

    <div class="warn-banner">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Are you sure you want to delete this event? This action cannot be undone.
    </div>

    <div class="field-row">
        <span class="field-label"><i class="bi bi-tag me-1"></i>Event Name</span>
        <span class="field-value">@Html.DisplayFor(model => model.EventName)</span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-text-paragraph me-1"></i>Description</span>
        <span class="field-value">@Html.DisplayFor(model => model.Description)</span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-circle-half me-1"></i>Status</span>
        <span class="field-value">
            @if (Model.Status == 1)
            { <span class="badge-status badge-published">Published</span> }
            else
            { <span class="badge-status badge-draft">Draft (@Model.Status)</span> }
        </span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-calendar3 me-1"></i>Publish Date</span>
        <span class="field-value">
            @(Model.PublishDate.HasValue ? Model.PublishDate.Value.ToString("MMM dd, yyyy HH:mm") : "N/A")
        </span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-toggle-on me-1"></i>Is Active</span>
        <span class="field-value">
            @if (Model.IsActive)
            { <span class="badge-status badge-active"><i class="bi bi-check-circle me-1"></i>Active</span> }
            else
            { <span class="badge-status badge-inactive"><i class="bi bi-x-circle me-1"></i>Inactive</span> }
        </span>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="EventThuanVctid" />
        <div class="action-bar">
            <button type="submit" class="btn-danger-custom">
                <i class="bi bi-trash3"></i> Delete
            </button>
            <button type="button" id="btnHubDelete" class="btn-signalr">
                <i class="bi bi-broadcast"></i> Delete via SignalR
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/eventHub")
            .build();

        connection.start().catch(err => console.error(err.toString()));

        document.getElementById("btnHubDelete").addEventListener("click", function (event) {
            const id = @Model.EventThuanVctid;
            // const id = "@Model.EventThuanVctid";
            connection.invoke("HubDeleteEvent", id)
                .then(function() {
                    window.location.href = '/EventsThuanVcts/Index';
                })
                .catch(err => console.error(err.toString()));
        });
    </script>
}
