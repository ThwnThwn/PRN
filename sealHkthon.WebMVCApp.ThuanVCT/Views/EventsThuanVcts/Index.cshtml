@model IEnumerable<sealHkthon.Entities.ThuanVCT.Models.EventsThuanVct>

@{
    ViewData["Title"] = "Events Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 mt-3 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Hackathon Events</h2>
        <p class="text-secondary mb-0">Manage and monitor all active and upcoming hackathons.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-clean d-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Create New Event</span>
        </a>
    </div>
</div>

<div class="clean-table-container">
    <div class="table-responsive">
        <table class="table table-clean table-hover mb-0">
            <thead>
                <tr>
                    <th style="width: 25%;">Event Name</th>
                    <th style="width: 30%;">Description</th>
                    <th>Status</th>
                    <th>Publish Date</th>
                    <th class="text-center">Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-light-muted"></i>
                            No events found. Start by creating a new one.
                        </td>
                    </tr>
                }
                @foreach (var item in Model) {
                <tr>
                    <td class="fw-medium text-dark align-middle">
                        @item.EventName
                    </td>
                    <td class="align-middle">
                        <div style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Description">
                            @item.Description
                        </div>
                    </td>
                    <td class="align-middle">
                        @if (item.Status == 1)
                        {
                            <span class="badge badge-clean badge-clean-active">Published</span>
                        }
                        else
                        {
                            <span class="badge badge-clean bg-light text-secondary border">Draft</span>
                        }
                    </td>
                    <td class="align-middle">
                        @(item.PublishDate.HasValue ? item.PublishDate.Value.ToString("MMM dd, yyyy") : "N/A")
                    </td>
                    <td class="align-middle text-center">
                        @if (item.IsActive)
                        {
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                        }
                    </td>
                    <td class="align-middle text-end">
                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.EventThuanVctid" class="btn btn-light border text-primary" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.EventThuanVctid" class="btn btn-light border text-info" title="Details">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.EventThuanVctid" class="btn btn-light border text-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
