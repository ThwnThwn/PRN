@model sealHkthon.Entities.ThuanVCT.Models.EventsThuanVct

@{
    ViewData["Title"] = "Event Details";
}

<style>
    .detail-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2rem 2.5rem;
        max-width: 680px;
        margin: 2rem auto;
    }
    .detail-card .card-header-section {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
    }
    .detail-card .card-icon {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, #3b6ef8, #60a5fa);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.4rem;
        flex-shrink: 0;
    }
    .detail-card h2 {
        font-size: 1.4rem; font-weight: 700;
        color: #1a1a2e; margin: 0;
    }
    .detail-card .subtitle {
        font-size: 0.82rem; color: #888; margin: 0;
    }
    .field-row {
        display: flex;
        align-items: flex-start;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f5f5f5;
        gap: 1rem;
    }
    .field-row:last-child { border-bottom: none; }
    .field-label {
        width: 130px; flex-shrink: 0;
        font-size: 0.8rem; font-weight: 600;
        color: #888; text-transform: uppercase;
        letter-spacing: 0.04em; padding-top: 2px;
    }
    .field-value {
        flex: 1;
        font-size: 0.97rem; color: #1a1a2e; font-weight: 500;
        transition: background-color 0.4s ease, color 0.4s ease;
        border-radius: 6px;
        padding: 2px 6px;
    }
    .badge-status {
        display: inline-block;
        padding: 3px 12px; border-radius: 20px;
        font-size: 0.78rem; font-weight: 600;
    }
    .badge-published { background: #d4edda; color: #155724; }
    .badge-draft     { background: #f0f0f0; color: #666; }
    .badge-active    { background: #d1ecf1; color: #0c5460; }
    .badge-inactive  { background: #f8d7da; color: #721c24; }
    .action-bar {
        display: flex; gap: 0.75rem;
        margin-top: 1.5rem; padding-top: 1rem;
        border-top: 2px solid #f0f0f0;
    }
    .btn-edit {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 20px; border-radius: 8px;
        background: linear-gradient(135deg, #3b6ef8, #60a5fa);
        color: white; font-weight: 600; font-size: 0.88rem;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .btn-edit:hover { opacity: 0.88; color: white; }
    .btn-back {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 20px; border-radius: 8px;
        background: #f0f0f0; color: #555;
        font-weight: 600; font-size: 0.88rem;
        text-decoration: none;
        transition: background 0.2s;
    }
    .btn-back:hover { background: #e0e0e0; color: #333; }
    /* SignalR live badge */
    .live-badge {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 0.72rem; background: #eef2ff; color: #3b6ef8;
        padding: 2px 10px; border-radius: 20px; font-weight: 600;
    }
    .live-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #3b6ef8;
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(0.7); }
    }
</style>

<div id="EventThuanVctid" class="detail-card">
    <div class="card-header-section">
        <div class="card-icon"><i class="bi bi-calendar-event"></i></div>
        <div>
            <h2>Event Details</h2>
            <p class="subtitle">EventsThuanVct &nbsp;·&nbsp; ID: @Model.EventThuanVctid</p>
        </div>
        <div class="ms-auto">
            <span class="live-badge"><span class="live-dot"></span>Live</span>
        </div>
    </div>

    <div class="field-row">
        <span class="field-label"><i class="bi bi-tag me-1"></i>Event Name</span>
        @* <dd class="col-sm-10"> *@   @* FIX: thêm id để getElementById hoạt động *@
        <span id="EventName" class="field-value">@Html.DisplayFor(model => model.EventName)</span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-text-paragraph me-1"></i>Description</span>
        @* <dd class="col-sm-10"> *@
        <span id="Description" class="field-value">@Html.DisplayFor(model => model.Description)</span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-circle-half me-1"></i>Status</span>
        @* <dd class="col-sm-10"> *@
        <span id="Status" class="field-value">
            @if (Model.Status == 1)
            {
                <span class="badge-status badge-published">Published</span>
            }
            else
            {
                <span class="badge-status badge-draft">Draft (@Model.Status)</span>
            }
        </span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-calendar3 me-1"></i>Publish Date</span>
        @* <dd class="col-sm-10"> *@
        <span id="PublishDate" class="field-value">
            @(Model.PublishDate.HasValue ? Model.PublishDate.Value.ToString("MMM dd, yyyy HH:mm") : "N/A")
        </span>
    </div>
    <div class="field-row">
        <span class="field-label"><i class="bi bi-toggle-on me-1"></i>Is Active</span>
        <span class="field-value">
            @if (Model.IsActive)
            {
                <span class="badge-status badge-active"><i class="bi bi-check-circle me-1"></i>Active</span>
            }
            else
            {
                <span class="badge-status badge-inactive"><i class="bi bi-x-circle me-1"></i>Inactive</span>
            }
        </span>
    </div>

    <div class="action-bar">
        <a asp-action="Edit" asp-route-id="@Model?.EventThuanVctid" class="btn-edit">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<script src="~/js/signalr/dist/browser/signalr.min.js"></script>
<script>
    // "use strict";

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/eventHub")
        .build();

    connection.start().catch(err => console.error(err.toString()));

    connection.on("Reciver_EventDeleted", function(eventId) {
		document.getElementById("EventThuanVctid").innerHTML = "This event has been deleted.";
		document.getElementById("EventThuanVctid").style.color = "red";
		document.getElementById("EventThuanVctid").style.backgroundColor = "black";
    });


    connection.on("Reciver_EventEdited", function (item) {
        // ❌ Cũ (sai - item.EventName là undefined vì SignalR serialize C# → camelCase)
        // document.getElementById("EventName").innerHTML = item.EventName;
        // document.getElementById("EventName").style.color = "blue";
        // document.getElementById("EventName").style.backgroundColor = "yellow";
        // document.getElementById("Description").innerHTML = item.Description;
        // document.getElementById("Status").innerHTML = item.Status;
        // document.getElementById("PublishDate").innerHTML = new Date(item.PublishDate).toLocaleString();

        // ✅ Mới (đúng - dùng camelCase)
		document.getElementById("EventName").innerHTML = item.eventName;
		document.getElementById("EventName").style.color = "blue";
		document.getElementById("EventName").style.backgroundColor = "yellow";
        document.getElementById("Description").innerHTML = item.description;
        document.getElementById("Status").innerHTML = item.status;
        document.getElementById("PublishDate").innerHTML = new Date(item.publishDate).toLocaleString();
    });
</script>