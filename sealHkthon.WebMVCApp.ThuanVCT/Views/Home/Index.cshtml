@{
    ViewData["Title"] = "Home Page - sealHkthon";
}

<!-- Hero Section -->
<div class="row align-items-center py-5 my-3">
    <div class="col-lg-6 text-start mb-4 mb-lg-0">
        <span class="hero-badge">
            <i class="bi bi-rocket-takeoff-fill"></i> SU26 Hackathon
        </span>
        <h1 class="display-4 fw-bold text-dark mb-3 lh-sm">
            Build Projects.<br />
            Solve Complex Challenges.
        </h1>
        <p class="fs-5 text-secondary mb-4 col-md-11 leading-relaxed">
            Welcome to sealHkthon, the platform where engineers gather to collaborate, innovate, and showcase software solutions. Join active hackathons to level up your technical skills.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="EventsThuanVcts" asp-action="Index" class="btn btn-primary-clean btn-lg d-flex align-items-center gap-2">
                <span>View Hackathons</span>
                <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
            <a href="#features" class="btn btn-secondary-clean btn-lg">
                Explore Features
            </a>
        </div>
    </div>

    <!-- Right Feature Panel -->
    <div class="col-lg-6">
        <div class="clean-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge badge-clean badge-clean-active">
                    <i class="bi bi-circle-fill me-1 small"></i> Active Stage
                </span>
                <span class="text-muted small">Updated Today</span>
            </div>
            
            <h4 class="text-dark mb-2">Hackathon Status Hub</h4>
            <p class="text-secondary small mb-4">Monitor active timelines, project submission windows, and round updates seamlessly.</p>
            
            <div class="d-flex flex-column gap-3">
                <div class="p-3 rounded bg-light border d-flex align-items-center gap-3">
                    <div class="fs-4 text-primary"><i class="bi bi-clock"></i></div>
                    <div>
                        <div class="text-dark fw-semibold small">Development Phase</div>
                        <div class="text-muted small">Check event timelines for active deadlines</div>
                    </div>
                </div>
                <div class="p-3 rounded bg-light border d-flex align-items-center gap-3">
                    <div class="fs-4 text-success"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="text-dark fw-semibold small">Team Formations</div>
                        <div class="text-muted small">Connect with developers on team registries</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Simple Metrics Grid -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="clean-card text-center py-4">
            <div class="stat-value">12+</div>
            <div class="text-dark fw-semibold small mb-1">Total Events</div>
            <div class="text-muted small">Active code challenges</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clean-card text-center py-4">
            <div class="stat-value">450+</div>
            <div class="text-dark fw-semibold small mb-1">Participants</div>
            <div class="text-muted small">Developers in the network</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clean-card text-center py-4">
            <div class="stat-value">$25,000</div>
            <div class="text-dark fw-semibold small mb-1">Prize Pool</div>
            <div class="text-muted small">Mentorship and cash grants</div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div id="features" class="py-5 my-3">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark">Platform Capabilities</h2>
        <p class="text-secondary col-md-6 mx-auto">Explore features built to host structured, fair, and high-quality hackathons.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="clean-card">
                <div class="feature-icon">
                    <i class="bi bi-code-square"></i>
                </div>
                <h5 class="text-dark mb-2">Coding Arenas</h5>
                <p class="text-secondary small">Carefully structured project requirements to evaluate technical problem-solving capabilities.</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="clean-card">
                <div class="feature-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <h5 class="text-dark mb-2">Multi-Round Structures</h5>
                <p class="text-secondary small">Step-by-step progress tracking from initial ideation down to the final prototype pitching.</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="clean-card">
                <div class="feature-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <h5 class="text-dark mb-2">Transparent Evaluation</h5>
                <p class="text-secondary small">Clean grading matrices evaluated by designated experts and system administrators.</p>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="my-5 py-5 text-center clean-card bg-light">
    <h2 class="fw-bold text-dark mb-2">Ready to Participate?</h2>
    <p class="text-secondary col-md-6 mx-auto mb-4">Browse through ongoing challenges, join an event, and build high-quality web applications.</p>
    <a asp-controller="EventsThuanVcts" asp-action="Index" class="btn btn-primary-clean btn-lg px-4">
        Browse Active Events
    </a>
</div>
